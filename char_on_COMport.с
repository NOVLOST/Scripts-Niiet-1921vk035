/*==============================================================================
 * Вывод символа через UART1 (пин B8) с интервалом 1 секунда
 * Микроконтроллер: К1921ВК035
 *============================================================================*/

#include "K1921VK035.h"
#include <stdint.h>

/**
 * @brief Программная задержка в миллисекундах.
 * @note Точность зависит от текущей частоты ядра (SystemCoreClock).
 */
void delay_ms(volatile uint32_t ms) {
    // При частоте 8 МГц: 8000000 / 4000 = 2000 итераций на 1 мс
    // При частоте 80 МГц: 80000000 / 4000 = 20000 итераций на 1 мс
    volatile uint32_t count = ms * (SystemCoreClock / 4000);
    while (count--) {
        __NOP();
    }
}

/**
 * @brief Инициализация UART1 на пине B8 (TX), скорость 115200 бод.
 */
void UART1_Init(void) {
    // 1. Включение тактирования порта GPIOB и снятие сброса
    RCU->HCLKCFG |= (1 << 1); // Бит 1 = GPIOB
    RCU->HRSTCFG |= (1 << 1);

    // 2. Конфигурация вывода B8 как альтернативная функция (UART1_TX)
    GPIOB->ALTFUNCSET = (1 << 8);
    GPIOB->DENSET = (1 << 8);

    // 3. Выбор источника тактирования для UART1 (OSICLK = 8 МГц)
    // CLKSEL = 11b (3), RSTDIS = 1, CLKEN = 1
    RCU->UARTCFG[1].UARTCFG = (3 << 8) | (1 << 4) | (1 << 0);

    // 4. Расчет делителей для скорости 115200 бод при частоте 8 МГц
    // Формула: K = F_uartclk / (16 * baudrate) = 8000000 / (16 * 115200) = 4.34
    // IBRD (целая часть) = 4
    // FBRD (дробная часть) = round(0.34 * 64) = 22
    UART1->CR = 0;          // Запрещаем UART перед изменением настроек
    UART1->IBRD = 4;
    UART1->FBRD = 22;

    // 5. Настройка формата кадра: FIFO включен, 8 бит данных
    UART1->LCRH = (1 << 4) | (3 << 5); // FEN=1, WLEN=3 (8 бит)

    // 6. Включение UART1: разрешение приема (RXE), передачи (TXE) и модуля (UARTEN)
    UART1->CR = (1 << 9) | (1 << 8) | (1 << 0);
}

/**
 * @brief Отправка одного символа через UART1.
 */
void UART1_SendChar(char c) {
    // Ожидаем, пока буфер передатчика не освободится (флаг TXFF = 0)
    while (UART1->FR_bit.TXFF) {
        // Ждем
    }
    // Записываем символ в регистр данных
    UART1->DR = c;
}

int main(void) {
    // Инициализация переменной системного тактирования
    // (по умолчанию после сброса микроконтроллер работает от внутреннего RC-генератора 8 МГц)
    SystemCoreClockUpdate();

    // Инициализация периферии
    UART1_Init();

    while (1) {
        // Отправка символа 'A' и переноса строки (\r\n для корректного отображения в терминале)
        UART1_SendChar('A');
        UART1_SendChar('\r');
        UART1_SendChar('\n');

        // Задержка 1 секунда
        delay_ms(1000);
    }
}
